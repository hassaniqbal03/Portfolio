# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# AI Chatbot Configuration (Optional external provider key)
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash


# Email Notification Settings (Nodemailer SMTP)
