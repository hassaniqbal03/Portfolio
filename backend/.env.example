# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS credentials
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# AI Chatbot Configuration (Optional external provider key)
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
