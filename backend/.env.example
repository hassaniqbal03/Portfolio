# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS credentials
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portfolio_db
DB_USER=root
